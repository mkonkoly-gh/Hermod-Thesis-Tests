hermod_mqtt_outbox_dropped_total 0
# HELP hermod_mqtt_outbox_drained_total Publishes replayed from the outbox on reconnect.
# TYPE hermod_mqtt_outbox_drained_total counter
hermod_mqtt_outbox_drained_total 0
# HELP hermod_mqtt_reconnects_total Successful broker reconnects by the MqttService supervisor (a flaky broker shows here as a rising slope).
# TYPE hermod_mqtt_reconnects_total counter
hermod_mqtt_reconnects_total 0
# HELP hermod_rule_publish_attempted_total Rule actions that attempted an MQTT publish.
# TYPE hermod_rule_publish_attempted_total counter
hermod_rule_publish_attempted_total 0
# HELP hermod_rule_publish_failed_total Rule actions whose publish threw or was dropped (bounded-channel overflow, MQTT disconnect mid-publish, serializer failure).
# TYPE hermod_rule_publish_failed_total counter
hermod_rule_publish_failed_total 0
# HELP hermod_mqtt_outbox_depth Current number of publishes buffered in the MQTT reconnect outbox.
# TYPE hermod_mqtt_outbox_depth gauge
hermod_mqtt_outbox_depth 0
# HELP hermod_ingest_queue_depth Current number of messages queued in the ingest channel (saturation arrives before drops).
# TYPE hermod_ingest_queue_depth gauge
hermod_ingest_queue_depth 0
# HELP hermod_rule_eval_seconds Rule evaluation latency in seconds.
# TYPE hermod_rule_eval_seconds histogram
hermod_rule_eval_seconds_bucket{le="0.0005"} 0
hermod_rule_eval_seconds_bucket{le="0.001"} 0
hermod_rule_eval_seconds_bucket{le="0.002"} 0
hermod_rule_eval_seconds_bucket{le="0.005"} 0
