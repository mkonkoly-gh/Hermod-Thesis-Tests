      # hostNetwork=true means localhost is the Pi host, NOT the
      # pod. nanomq lives in the cluster — reach it via cluster
      # DNS (dnsPolicy=ClusterFirstWithHostNet keeps the
      # cluster resolver visible to host-networked pods).
      exec python -m TheengsGateway \
        -H nanomq.translator-ble.svc.cluster.local -P 1883 \
        -pt bluetooth/BTtoMQTT \
        -Lt bluetooth/LWT \
        -D 0 -b 1
      
