hermod_device_state_writes_dropped_total 0
# HELP hermod_device_state_flush_failed_total Device-state batches that failed to flush to Postgres (entire batch lost). Non-zero = PG is unreachable or the INSERT errored; silently dropped rows with no queue-overflow signal.
# TYPE hermod_device_state_flush_failed_total counter
hermod_device_state_flush_failed_total 0
